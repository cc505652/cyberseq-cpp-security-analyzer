# =====================================================================
# AI-Powered Secure Code Analyzer Environment Configuration Template
# Copy this file to '.env' and populate your local API keys and settings.
# =====================================================================

# AI Provider Selection ("openai" for OpenAI Cloud, "ollama" for Local LLM, or "mock" for offline testing)
AI_PROVIDER=ollama

# --- OpenAI Cloud API Settings ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# --- Ollama Local LLM Settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Application Operational Settings ---
ENABLE_MOCK_FALLBACK=true
DEBUG_MODE=false
